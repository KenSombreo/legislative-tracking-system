DATABASE_URL=mongodb://localhost:27017/legislative_tracking
JWT_SECRET=change-this-dev-secret
JWT_EXPIRES_IN=7d
FILE_STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760
# Per-file limit for activity photos/videos (200 MB)
MAX_MEDIA_SIZE=209715200
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Tesseract language(s) for OCR of scanned PDFs, e.g. eng or eng+fil (needs ocrmypdf installed)
OCR_LANGUAGES=eng
# Self-hosted Whisper server that transcribes session recordings (free, runs on this server).
# Start one locally with:
#   docker run -d -p 9000:9000 -e ASR_ENGINE=faster_whisper -e ASR_MODEL=small onerahmet/openai-whisper-asr-webservice:v1.10.0
# Leave empty to turn transcription off (recordings can still be uploaded and played).
WHISPER_URL=http://localhost:9000
# Language spoken in sessions, e.g. tl (Tagalog) or en. Leave empty to let Whisper detect it.
WHISPER_LANGUAGE=
